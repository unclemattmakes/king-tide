node_modules/
dist/
.vite/
.vercel/
.partykit/
*.log
.DS_Store
Thumbs.db

# Compiled runtime assets (track/bike/prop GLBs, thumb/hero JPGs, atlas PNGs,
# opus soundtrack) are served from Cloudflare R2 — NOT git. This is what keeps
# Vercel deploys from re-pulling ~160 MB of git-LFS on every build. The app
# fetches them from VITE_ASSET_BASE_URL in prod (see src/engine/asset-url.ts).
# Hydrate a fresh clone for offline dev with `pnpm assets:pull`; push new
# exports with `pnpm assets:push`. See docs/asset-storage.md.
#
# Exception: the asset manifest (the canonical track/bike roster) is tiny, text,
# and load-bearing for the build — so it stays VERSIONED. We ignore the dir's
# *contents* (`/*`) rather than the dir itself so git can still descend into it
# to track the one re-included file below. Every asset BYTE stays ignored.
/public/assets/*
!/public/assets/manifest.json
/public/audio/

# Brush-stroke stamps harvested from the Blender Brushstroke Tools add-on — build
# inputs for gen:brush-texture, derived from a third-party asset. Re-derive locally
# with `pnpm gen:brush-stamps` (see brush_stamps/README.md). The shipped
# brush_strokes.png lives on R2 like the other compiled assets.
/tools/blender/brush_stamps/*.png

# vitepress
docs-site/.vitepress/cache/
docs-site/.vitepress/dist/

# tests
test-results/
playwright-report/
playwright/.cache/
coverage/
foam-shots/
# Local capture evidence from harness specs (wave-zone-sync,
# determinism-snapshot) — kept OUT of test-results/ so Playwright's
# run-start clean doesn't delete a `before` capture, and out of git
# because they're machine-local screenshots/snapshots.
artifacts/

# QA orchestrator output (pnpm qa). Committed CI artifacts live on
# the workflow upload; local runs stay out of git.
qa-report/

# Perf profiling output (pnpm profile). The committed anchor is the
# fill-in baseline at docs/perf-baseline.md; raw run reports stay out of
# git. The dir itself stays (perf-report/.gitkeep is tracked).
perf-report/perf-*.md

# editor
.vscode/
.idea/
.claude/

# blender
# Raw .blend authoring sources live on the asset bucket (Drive), not in
# git — synced via `pnpm assets:pull` / `assets:push`, auto-backed-up by
# the pre-push hook. See docs/asset-storage.md. (tracks-src/README.md +
# blender_assets.cats.txt stay tracked.)
tracks-src/*.blend
bikes-src/*.blend
tracks-src/*.blend1
bikes-src/*.blend1
tracks-src/*.blend@
bikes-src/*.blend@
tools/blender/lib/*.blend1
tools/blender/lib/*.blend@
# Non-destructive re-seed safety backups (the seed writes <lib>.blend.seedbak
# before every save; .preseed-bak is a manual pre-run copy).
*.blend.seedbak
*.blend.preseed-bak

# python bytecode (Blender headless scripts)
__pycache__/
*.pyc

# make-level-props scratch: raw Hunyuan meshes, Blender spec files, server
# logs. Throwaway intermediates — the committed anchors are the conditioned
# GLB (public/assets/props/ai/) + the manifest (specs/props/ai/).
tools/ai_prop_runs/

# Electron desktop build output (Steam Deck / Windows wrappers)
dist-electron/
