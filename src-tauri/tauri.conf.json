{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoverbike",
  "version": "0.0.0",
  "identifier": "app.hoverbike",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5191",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hoverbike",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "shortDescription": "Post-flood arcade hover-bike racing",
    "longDescription": "Wave-mastery arcade racing on a drowned Earth. Eleven recognisable real-world coasts seen post-flood, played in canonical bikes.",
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
