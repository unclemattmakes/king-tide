#!/bin/sh
# pre-push — block the push unless local verification passes.
#
# Opt in by pointing git at this hooks dir (one-time, per clone):
#     git config core.hooksPath .githooks
# CI for this repo is unreliable (aborts at setup on a spending-limit
# failure — see CLAUDE.md hard rule 1), so the local gate is the real one.
#
# Runs `pnpm verify` (typecheck + lint + test). Any non-zero exit aborts
# the push.
echo "[pre-push] running 'pnpm verify' (typecheck + lint + test) before push…"
pnpm verify
