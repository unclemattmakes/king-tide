// SteamPipe depot script — Linux (Electron game tree).
//
// The Steam Deck path: a native Linux depot so the Deck always
// prefers this over running Windows-via-Proton. Mark the depot
// "Steam Deck verified" in the App admin after the first upload.
//
// Input layout: tools/steam-upload.mjs stages the electron-builder
// linux-unpacked tree (Chromium bundled) into content/linux/. Set the
// App's Linux launch executable to `hoverbike-launch.sh` (the wrapper that
// strips the crashing Steam overlay + adds libcups — see
// docs/desktop-builds.md), NOT `hoverbike` directly.
"DepotBuildConfig"
{
	"DepotID"		"${STEAM_DEPOT_LINUX}"

	"FileMapping"
	{
		"LocalPath"		"linux\\*"
		"DepotPath"		"."
		"recursive"		"1"
	}

	// AppImages already contain a compressed squashfs payload; the
	// Steam content server's own chunk dedup wins us little extra,
	// but turning on FileExclusion patterns lets us drop dev junk
	// if anything sneaks in.
	"FileExclusion"		"*.log"
	"FileExclusion"		"*.tmp"
}
