// SteamPipe depot script — Windows (Electron game tree).
//
// We upload the installed game tree, not the NSIS installer — Steam
// handles install/uninstall via the depot manifest. tools/steam-upload.mjs
// stages the electron-builder win-unpacked tree (Chromium bundled) into
// content/windows/. Set the App's Windows launch executable to
// `Hoverbike.exe` in the Steamworks backend.
"DepotBuildConfig"
{
	"DepotID"		"${STEAM_DEPOT_WINDOWS}"

	"FileMapping"
	{
		"LocalPath"		"windows\\*"
		"DepotPath"		"."
		"recursive"		"1"
	}

	"FileExclusion"		"*.log"
	"FileExclusion"		"*.tmp"
	"FileExclusion"		"*.pdb"
}
