{
  "name": "hoverbike",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unclemattmakes/king-tide.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "description": "Wave-mastery arcade hover-bike racing on a drowned Earth.",
  "author": "Uncle Matt Makes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "party:dev": "partykit dev --port 1999",
    "party:deploy": "partykit deploy",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "assets:pull": "rclone copy r2-hoverbike:hoverbike-content/assets public/assets --transfers 16 --checkers 16 && rclone copy r2-hoverbike:hoverbike-content/audio public/audio --transfers 16 --checkers 16",
    "assets:push": "rclone copy public/assets r2-hoverbike:hoverbike-content/assets --transfers 16 --checkers 16 --s3-no-check-bucket --exclude \"*.bak\" --exclude \"*.orig\" --exclude \"*.tmp\" --exclude \"*~\" && rclone copy public/audio r2-hoverbike:hoverbike-content/audio --transfers 16 --checkers 16 --s3-no-check-bucket --exclude \"*.bak\" --exclude \"*.orig\" --exclude \"*.tmp\" --exclude \"*~\"",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "validate:tracks": "node tools/validate-track-assets.mjs",
    "preflight:steam": "pnpm verify && pnpm build && node tools/check-assets-present.mjs && node tools/validate-track-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "qa": "node tools/qa/runner.mjs",
    "profile": "node tools/profile-tracks.mjs",
    "qa:smoke": "QA_MATRIX=1 playwright test tests/e2e/qa-track-matrix.spec.ts",
    "qa:soak": "QA_SOAK=1 playwright test tests/e2e/qa-soak.spec.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "gen:bikes": "node tools/blender/run.mjs build_bike specs/bikes",
    "gen:bike-thumbs": "node tools/gen-bike-thumbs.mjs",
    "gen:track-shots": "node tools/gen-track-shots.mjs",
    "gen:ui-shots": "node tools/gen-ui-shots.mjs",
    "gen:prop-sheets": "node tools/gen-prop-sheets.mjs",
    "gen:props": "node tools/blender/run.mjs build_prop specs/props",
    "gen:cloud-props": "node tools/blender/seed.mjs build_cloud_props.py",
    "gen:tracks": "node tools/blender/run.mjs build_track specs/tracks",
    "gen:tracks:validate": "node tools/blender/run-lint.mjs",
    "gen:all": "node tools/blender/run.mjs build_all",
    "gen:manifest": "node tools/blender/run.mjs manifest",
    "gen:music": "node tools/convert-music.mjs",
    "gen:fx-atlas": "python tools/blender/build_sprite_atlas.py",
    "gen:decal-atlas": "python tools/blender/build_decal_atlas.py",
    "gen:trim-sheets": "python tools/blender/build_trim_sheets.py",
    "gen:brush-texture": "python tools/blender/build_brush_texture.py",
    "gen:brush-stamps": "node tools/blender/seed.mjs harvest_brush_stamps.py",
    "install:blender-addon": "node tools/blender/install-addon.mjs",
    "test:blender": "node tools/blender/test-addon.mjs",
    "seed:landmarks-library": "node tools/blender/seed.mjs seed_landmarks_library.py",
    "seed:landmarks-showcase": "node tools/blender/seed.mjs seed_landmarks_showcase.py",
    "seed:track-sandbar": "node tools/blender/seed.mjs seed_track_sandbar.py",
    "seed:track-hatteras-light": "node tools/blender/seed.mjs seed_track_hatteras_light.py",
    "seed:track-cape-town-drift": "node tools/blender/seed.mjs seed_track_cape_town_drift.py",
    "seed:track-the-maw": "node tools/blender/seed.mjs seed_track_the_maw.py",
    "seed:track-shibuya-submerged": "node tools/blender/seed.mjs seed_track_shibuya_submerged.py",
    "seed:track-kilauea-crown": "node tools/blender/seed.mjs seed_track_kilauea_crown.py",
    "seed:track-marina-bay-7": "node tools/blender/seed.mjs seed_track_marina_bay_7.py",
    "seed:track-doges-drift": "node tools/blender/seed.mjs seed_track_doges_drift.py",
    "seed:track-aqualand": "node tools/blender/seed.mjs seed_track_aqualand.py",
    "seed:track-angkor-drowned": "node tools/blender/seed.mjs seed_track_angkor_drowned.py",
    "seed:track-liberty-drowned": "node tools/blender/seed.mjs seed_track_liberty_drowned.py",
    "seed:track-prop-showcase": "node tools/blender/seed.mjs seed_track_prop_showcase.py",
    "leaderboard:moderate": "node tools/leaderboard-moderate.mjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "electron:run": "pnpm build && electron .",
    "build:deck": "node tools/build-deck.mjs",
    "build:windows": "node tools/build-windows.mjs",
    "steam:upload": "node tools/steam-upload.mjs",
    "steam:dry-run": "node tools/steam-upload.mjs --dry-run",
    "gen:icons": "node tools/gen-icons.mjs",
    "gen:prop-gate": "node tools/blender/seed.mjs export_prop_gate.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "bitecs": "^0.4.0",
    "gl-matrix": "^3.4.4",
    "partysocket": "^1.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.7",
    "ajv": "^8.17.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "partykit": "^0.0.115",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "undici@<6.23.0": ">=6.23.0",
      "undici@<6.24.0": ">=6.24.0",
      "vite@<=6.4.1": ">=6.4.2",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1"
    }
  }
}
