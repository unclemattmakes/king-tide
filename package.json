{
  "name": "hoverbike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "biome check .",
    "format": "biome format --write .",
    "gen:bikes": "node tools/blender/run.mjs build_bike specs/bikes",
    "gen:props": "node tools/blender/run.mjs build_prop specs/props",
    "gen:tracks": "node tools/blender/run.mjs build_track specs/tracks",
    "gen:all": "node tools/blender/run.mjs build_all",
    "gen:manifest": "node tools/blender/run.mjs manifest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "bitecs": "^0.4.0",
    "gl-matrix": "^3.4.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "ajv": "^8.17.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/three": "^0.184.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
