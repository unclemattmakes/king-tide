# Normalize all text files to LF in the repo and on checkout.
#
# Without this, contributors on Windows (where `core.autocrlf=true` is
# the default git install setting) get CRLF in their working tree and
# Biome's formatter reports every file as a diff. The check is platform-
# correct but practically unrunnable. Pinning LF here makes `pnpm lint`
# pass identically across Linux / macOS / Windows.
#
# `text=auto` lets git detect text vs binary; `eol=lf` forces LF on
# checkout for everything classified as text.
* text=auto eol=lf

# Binary asset types — never normalize, never diff as text. These would
# corrupt if git tried to translate line endings.
*.glb       binary
*.gltf      binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.blend     binary
*.blend1    binary
*.ogg       binary
*.mp3       binary
*.wav       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.exe       binary
*.dll       binary
*.dylib     binary
*.so        binary

# Shell scripts must stay LF even if a future contributor's git is
# weird. Belt + suspenders given `* text=auto eol=lf` above.
*.sh        text eol=lf

# --- Large compiled/exported runtime assets → Git LFS ------------------
#
# The heavy, frequently-regenerated artifacts the web build + Vercel serve
# from public/assets/ (track / bike / prop / landmark GLBs, hero & thumb
# JPGs, texture-atlas PNGs). Storing them in LFS keeps the working .git
# lean — re-exports add a pointer here and the bytes go to the LFS store,
# instead of a fresh multi-MB blob in the pack on every regen.
#
# FORWARD-ONLY: this converts assets committed *after* this change. The
# GLBs already in history stay as ordinary blobs until an opt-in
# `git lfs migrate` / filter-repo rewrite (see docs/asset-storage.md).
#
# PREREQUISITE: every clone / CI runner / Vercel deploy that checks these
# out must have `git lfs install` run once, or LFS-tracked files arrive as
# pointer text. See docs/asset-storage.md for the Vercel toggle.
public/assets/**/*.glb   filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.jpeg  filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.png   filter=lfs diff=lfs merge=lfs -text
# Compiled soundtrack — Opus tracks transcoded by `pnpm gen:music` from the
# off-git .mp3 sources. ~2-4 MB each, regenerated occasionally; LFS keeps
# them out of the working pack like the other compiled runtime assets.
public/audio/**/*.opus   filter=lfs diff=lfs merge=lfs -text
