{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hoverbike.local/specs/track.json",
  "title": "Track spec",
  "description": "Declarative description of a track scene. The Blender headless builder reads this file, constructs the scene programmatically (matching build_calibration_scene.py's output), and exports a GLB via tools/export_track.py.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "displayName"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "lapsToFinish": { "type": "integer", "minimum": 1, "maximum": 99 },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, length] in metres (Blender X, Y)."
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50,
          "description": "Slab thickness (m). Default 1.0. The top face sits at three y=0; the slab extrudes downward. Avoid 0 — flat-plane trimeshes are tunnel-prone in Rapier 0.19's discrete broadphase."
        }
      }
    },
    "water": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "extents": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "waveHeight": {
          "type": "number",
          "minimum": 0,
          "description": "Blender wave-preview amplitude multiplier only; NOT exported to runtime JSON (runtime amplitude = sky.seaStateBeaufort + waveZones)."
        },
        "waveFreq": {
          "type": "number",
          "minimum": 0,
          "description": "Blender wave-preview frequency multiplier only; NOT exported to runtime JSON."
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["y", "halfWidth", "height"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
          "halfWidth": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "aiSpline": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 2
    },
    "starts": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 3,
        "maxItems": 4,
        "description": "[x, y, z] (Blender axes) or [x, y, z, yaw] (yaw in radians; 0 = facing three +Z forward, π/2 = facing three +X right). yaw is optional, default 0."
      },
      "minItems": 1
    },
    "pickups": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
